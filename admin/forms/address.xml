<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomSermon\Component\Sermondistributor\Administrator\Rule"
	addfieldprefix="JoomSermon\Component\Sermondistributor\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_CREATED_DATE_LABEL"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_CREATED_BY_LABEL"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_CREATED_BY_DESC"
		/>
		<!-- Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_MODIFIED_DATE_LABEL" description="COM_SERMONDISTRIBUTOR_ADDRESS_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_MODIFIED_BY_LABEL"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_VERSION_LABEL"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Metakey Field. Type: Textarea (joomla) -->
		<field
			name="metakey"
			type="textarea"
			label="JFIELD_META_KEYWORDS_LABEL"
			description="JFIELD_META_KEYWORDS_DESC"
			rows="3"
			cols="30"
		/>
		<!-- Metadesc Field. Type: Textarea (joomla) -->
		<field
			name="metadesc"
			type="textarea"
			label="JFIELD_META_DESCRIPTION_LABEL"
			description="JFIELD_META_DESCRIPTION_DESC"
			rows="3"
			cols="30"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="sermondistributor address"
		/>
		<!-- Dynamic Fields. -->
		<!-- Line_one Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="line_one"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_LINE_ONE_LABEL"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_LINE_ONE_DESCRIPTION"
			class="text_area"
			required="true"
			filter="STRING"
			message="COM_SERMONDISTRIBUTOR_ADDRESS_LINE_ONE_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_LINE_ONE_HINT"
		/>
		<!-- Type Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="type"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_TYPE_LABEL"
			sql_title_table="#__sermondistributor_address_type"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_sermondistributor&amp;view=address_types&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_sermondistributor&amp;task=address_type.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_sermondistributor&amp;task=address_type.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERMONDISTRIBUTOR_ADDRESS_TYPE_TITLESELECT"
			titleNew="COM_SERMONDISTRIBUTOR_ADDRESS_TYPE_TITLENEW"
			titleEdit="COM_SERMONDISTRIBUTOR_ADDRESS_TYPE_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="true"
			class="input-large"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_TYPE_DESCRIPTION"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_TYPE_HINT"
		/>
		<!-- Country Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="country"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_COUNTRY_LABEL"
			sql_title_table="#__sermondistributor_country"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_sermondistributor&amp;view=countries&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_sermondistributor&amp;task=country.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_sermondistributor&amp;task=country.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERMONDISTRIBUTOR_ADDRESS_COUNTRY_TITLESELECT"
			titleNew="COM_SERMONDISTRIBUTOR_ADDRESS_COUNTRY_TITLENEW"
			titleEdit="COM_SERMONDISTRIBUTOR_ADDRESS_COUNTRY_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="true"
			class="input-large"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_COUNTRY_DESCRIPTION"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_COUNTRY_HINT"
		/>
		<!-- State Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="state"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_STATE_LABEL"
			sql_title_table="#__sermondistributor_state"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_sermondistributor&amp;view=states&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_sermondistributor&amp;task=state.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_sermondistributor&amp;task=state.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERMONDISTRIBUTOR_ADDRESS_STATE_TITLESELECT"
			titleNew="COM_SERMONDISTRIBUTOR_ADDRESS_STATE_TITLENEW"
			titleEdit="COM_SERMONDISTRIBUTOR_ADDRESS_STATE_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="true"
			class="input-large"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_STATE_DESCRIPTION"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_STATE_HINT"
		/>
		<!-- City Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="city"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_CITY_LABEL"
			sql_title_table="#__sermondistributor_city"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_sermondistributor&amp;view=cities&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_sermondistributor&amp;task=city.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_sermondistributor&amp;task=city.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERMONDISTRIBUTOR_ADDRESS_CITY_TITLESELECT"
			titleNew="COM_SERMONDISTRIBUTOR_ADDRESS_CITY_TITLENEW"
			titleEdit="COM_SERMONDISTRIBUTOR_ADDRESS_CITY_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			class="input-large"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_CITY_DESCRIPTION"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_CITY_HINT"
		/>
		<!-- Preacher Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="preacher"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_PREACHER_LABEL"
			sql_title_table="#__sermondistributor_preacher"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_sermondistributor&amp;view=preachers&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_sermondistributor&amp;task=preacher.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_sermondistributor&amp;task=preacher.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERMONDISTRIBUTOR_ADDRESS_PREACHER_TITLESELECT"
			titleNew="COM_SERMONDISTRIBUTOR_ADDRESS_PREACHER_TITLENEW"
			titleEdit="COM_SERMONDISTRIBUTOR_ADDRESS_PREACHER_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="false"
			filter="STRING"
			class="input-large"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_PREACHER_DESCRIPTION"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_PREACHER_HINT"
		/>
		<!-- Church Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="church"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_CHURCH_LABEL"
			sql_title_table="#__sermondistributor_church"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_sermondistributor&amp;view=churches&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_sermondistributor&amp;task=church.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_sermondistributor&amp;task=church.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERMONDISTRIBUTOR_ADDRESS_CHURCH_TITLESELECT"
			titleNew="COM_SERMONDISTRIBUTOR_ADDRESS_CHURCH_TITLENEW"
			titleEdit="COM_SERMONDISTRIBUTOR_ADDRESS_CHURCH_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="false"
			class="input-large"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_CHURCH_HINT"
		/>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_GUID_HINT"
		/>
		<!-- Postal Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="postal"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_POSTAL_LABEL"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_POSTAL_DESCRIPTION"
			class="text_area"
			required="false"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_POSTAL_HINT"
		/>
		<!-- Line_two Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="line_two"
			label="COM_SERMONDISTRIBUTOR_ADDRESS_LINE_TWO_LABEL"
			description="COM_SERMONDISTRIBUTOR_ADDRESS_LINE_TWO_DESCRIPTION"
			class="text_area"
			required="false"
			filter="STRING"
			hint="COM_SERMONDISTRIBUTOR_ADDRESS_LINE_TWO_HINT"
		/>
	</fieldset>

	<!-- Metadata Fields. -->
	<fields name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
		<fieldset name="vdmmetadata"
			label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
			<!-- Robots Field. Type: List (joomla) -->
			<field name="robots"
				type="list"
				label="JFIELD_METADATA_ROBOTS_LABEL"
				description="JFIELD_METADATA_ROBOTS_DESC" >
				<option value="">JGLOBAL_USE_GLOBAL</option>
				<option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
				<option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
				<option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
				<option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
			</field>
			<!-- Author Field. Type: Text (joomla) -->
			<field name="author"
				type="text"
				label="JAUTHOR" description="JFIELD_METADATA_AUTHOR_DESC"
				size="20"
			/>
			<!-- Rights Field. Type: Textarea (joomla) -->
			<field name="rights" type="textarea" label="JFIELD_META_RIGHTS_LABEL"
				description="JFIELD_META_RIGHTS_DESC" required="false" filter="string"
				cols="30" rows="2"
			/>
		</fieldset>
	</fields>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this address"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_sermondistributor"
			section="address"
		/>
	</fieldset>
</form>