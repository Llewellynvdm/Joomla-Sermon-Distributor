<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomSermon\Component\Sermondistributor\Administrator\Rule"
	addfieldprefix="JoomSermon\Component\Sermondistributor\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_CREATED_DATE_LABEL"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_CREATED_BY_LABEL"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_CREATED_BY_DESC"
		/>
		<!-- Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_MODIFIED_DATE_LABEL" description="COM_SERMONDISTRIBUTOR_FILE_TYPE_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_MODIFIED_BY_LABEL"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_VERSION_LABEL"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Metakey Field. Type: Textarea (joomla) -->
		<field
			name="metakey"
			type="textarea"
			label="JFIELD_META_KEYWORDS_LABEL"
			description="JFIELD_META_KEYWORDS_DESC"
			rows="3"
			cols="30"
		/>
		<!-- Metadesc Field. Type: Textarea (joomla) -->
		<field
			name="metadesc"
			type="textarea"
			label="JFIELD_META_DESCRIPTION_LABEL"
			description="JFIELD_META_DESCRIPTION_DESC"
			rows="3"
			cols="30"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="sermondistributor file_type"
		/>
		<!-- Dynamic Fields. -->
		<!-- Name Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="name"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_LABEL"
			size="40"
			maxlength="150"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_DESCRIPTION"
			class="text_area"
			readonly="false"
			disabled="false"
			required="true"
			filter="STRING"
			message="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_HINT"
		/>
		<!-- Type Field. Type: List. (joomla) -->
		<field
			type="list"
			name="type"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_TYPE_LABEL"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_TYPE_DESCRIPTION"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="false"
			required="true">
			<!-- Option Set. -->
			<option value="">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_SELECT_A_OPTION</option>
			<option value="1">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_IMAGE</option>
			<option value="2">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_DOCUMENT</option>
			<option value="3">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_MEDIA</option>
			<option value="4">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_FILE</option>
		</field>
		<!-- Path Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="path"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_PATH_LABEL"
			size="10"
			maxlength="50"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_PATH_DESCRIPTION"
			class="text_area"
			required="true"
			filter="PATH"
			message="COM_SERMONDISTRIBUTOR_FILE_TYPE_PATH_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_FILE_TYPE_PATH_HINT"
		/>
		<!-- Download_access Field. Type: Accesslevel. (joomla) -->
		<field
			type="accesslevel"
			name="download_access"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_DOWNLOAD_ACCESS_LABEL"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_DOWNLOAD_ACCESS_DESCRIPTION"
			class="list_class"
			required="true"
			multiple="false"
		/>
		<!-- Quantity Field. Type: Number. (joomla) -->
		<field
			type="number"
			name="quantity"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_QUANTITY_LABEL"
			default="0"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_QUANTITY_DESCRIPTION"
			class="text_area"
			required="true"
			min="0"
			max="10"
			step="1"
		/>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERMONDISTRIBUTOR_FILE_TYPE_GUID_HINT"
		/>
		<!-- Target Field. Type: List. (joomla) -->
		<field
			type="list"
			name="target"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_TARGET_LABEL"
			layout="joomla.form.field.list-fancy-select"
			multiple="true"
			required="true">
			<!-- Option Set. -->
			<option value="preacher">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_PREACHER</option>
			<option value="sermon">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_SERMON</option>
			<option value="church">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_CHURCH</option>
			<option value="category">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_CATEGORY</option>
			<option value="tag">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_TAG</option>
			<option value="series">
				COM_SERMONDISTRIBUTOR_FILE_TYPE_SERIES</option>
		</field>
		<!-- Crop Field. Type: Subform. (joomla) -->
		<field
			type="subform"
			name="crop"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_CROP_LABEL"
			layout="joomla.form.field.subform.repeatable-table"
			multiple="true"
			buttons="add,remove"
			description="COM_SERMONDISTRIBUTOR_FILE_TYPE_CROP_DESCRIPTION"
			icon="list"
			max="10"
			min="0"
			filter="STRING"
			showon="type:1">
			<form hidden="true" name="list_crop_modal" repeat="true">
				<!-- Name Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="name"
					label="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_LABEL"
					size="40"
					maxlength="150"
					description="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_DESCRIPTION"
					class="text_area"
					readonly="false"
					disabled="false"
					required="true"
					filter="STRING"
					message="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_MESSAGE"
					hint="COM_SERMONDISTRIBUTOR_FILE_TYPE_NAME_HINT"
				/>
				<!-- Height Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="height"
					label="COM_SERMONDISTRIBUTOR_FILE_TYPE_HEIGHT_LABEL"
					size="10"
					maxlength="50"
					description="COM_SERMONDISTRIBUTOR_FILE_TYPE_HEIGHT_DESCRIPTION"
					class="text_area"
					filter="INT"
					hint="COM_SERMONDISTRIBUTOR_FILE_TYPE_HEIGHT_HINT"
					autocomplete="on"
					onchange="this.value = this.value.replace(/\D/g, '');"
				/>
				<!-- Width Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="width"
					label="COM_SERMONDISTRIBUTOR_FILE_TYPE_WIDTH_LABEL"
					size="10"
					maxlength="50"
					description="COM_SERMONDISTRIBUTOR_FILE_TYPE_WIDTH_DESCRIPTION"
					class="text_area"
					filter="INT"
					hint="COM_SERMONDISTRIBUTOR_FILE_TYPE_WIDTH_HINT"
					autocomplete="on"
					onchange="this.value = this.value.replace(/\D/g, '');"
				/>
			</form>
		</field>
		<!-- File_formats Field. Type: Allowedfileformats. (custom) -->
		<field
			type="allowedfileformats"
			name="file_formats"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_FILE_FORMATS_LABEL"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="true"
			showon="type:4"
		/>
		<!-- Document_formats Field. Type: Alloweddocumentformats. (custom) -->
		<field
			type="alloweddocumentformats"
			name="document_formats"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_DOCUMENT_FORMATS_LABEL"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="true"
			showon="type:2"
		/>
		<!-- Media_formats Field. Type: Allowedmediaformats. (custom) -->
		<field
			type="allowedmediaformats"
			name="media_formats"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_MEDIA_FORMATS_LABEL"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="true"
			showon="type:3"
		/>
		<!-- Image_formats Field. Type: Allowedimageformats. (custom) -->
		<field
			type="allowedimageformats"
			name="image_formats"
			label="COM_SERMONDISTRIBUTOR_FILE_TYPE_IMAGE_FORMATS_LABEL"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="true"
			showon="type:1"
		/>
	</fieldset>

	<!-- Metadata Fields. -->
	<fields name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
		<fieldset name="vdmmetadata"
			label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
			<!-- Robots Field. Type: List (joomla) -->
			<field name="robots"
				type="list"
				label="JFIELD_METADATA_ROBOTS_LABEL"
				description="JFIELD_METADATA_ROBOTS_DESC" >
				<option value="">JGLOBAL_USE_GLOBAL</option>
				<option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
				<option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
				<option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
				<option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
			</field>
			<!-- Author Field. Type: Text (joomla) -->
			<field name="author"
				type="text"
				label="JAUTHOR" description="JFIELD_METADATA_AUTHOR_DESC"
				size="20"
			/>
			<!-- Rights Field. Type: Textarea (joomla) -->
			<field name="rights" type="textarea" label="JFIELD_META_RIGHTS_LABEL"
				description="JFIELD_META_RIGHTS_DESC" required="false" filter="string"
				cols="30" rows="2"
			/>
		</fieldset>
	</fields>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this file_type"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_sermondistributor"
			section="file_type"
		/>
	</fieldset>
</form>