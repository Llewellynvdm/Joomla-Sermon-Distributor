<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomSermon\Component\Sermondistributor\Administrator\Rule"
	addfieldprefix="JoomSermon\Component\Sermondistributor\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERMONDISTRIBUTOR_CHURCH_CREATED_DATE_LABEL"
			description="COM_SERMONDISTRIBUTOR_CHURCH_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERMONDISTRIBUTOR_CHURCH_CREATED_BY_LABEL"
			description="COM_SERMONDISTRIBUTOR_CHURCH_CREATED_BY_DESC"
		/>
		<!-- Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERMONDISTRIBUTOR_CHURCH_MODIFIED_DATE_LABEL" description="COM_SERMONDISTRIBUTOR_CHURCH_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERMONDISTRIBUTOR_CHURCH_MODIFIED_BY_LABEL"
			description="COM_SERMONDISTRIBUTOR_CHURCH_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERMONDISTRIBUTOR_CHURCH_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERMONDISTRIBUTOR_CHURCH_VERSION_LABEL"
			description="COM_SERMONDISTRIBUTOR_CHURCH_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Metakey Field. Type: Textarea (joomla) -->
		<field
			name="metakey"
			type="textarea"
			label="JFIELD_META_KEYWORDS_LABEL"
			description="JFIELD_META_KEYWORDS_DESC"
			rows="3"
			cols="30"
		/>
		<!-- Metadesc Field. Type: Textarea (joomla) -->
		<field
			name="metadesc"
			type="textarea"
			label="JFIELD_META_DESCRIPTION_LABEL"
			description="JFIELD_META_DESCRIPTION_DESC"
			rows="3"
			cols="30"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="sermondistributor church"
		/>
		<!-- Dynamic Fields. -->
		<!-- Name Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="name"
			label="COM_SERMONDISTRIBUTOR_CHURCH_NAME_LABEL"
			size="40"
			maxlength="150"
			description="COM_SERMONDISTRIBUTOR_CHURCH_NAME_DESCRIPTION"
			class="text_area"
			readonly="false"
			disabled="false"
			required="true"
			filter="STRING"
			message="COM_SERMONDISTRIBUTOR_CHURCH_NAME_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_NAME_HINT"
		/>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERMONDISTRIBUTOR_CHURCH_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERMONDISTRIBUTOR_CHURCH_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_GUID_HINT"
		/>
		<!-- Note_file_vdm_display Field. Type: Note. A None Database Field. (joomla) -->
		<field type="note" name="note_file_vdm_display" description="COM_SERMONDISTRIBUTOR_CHURCH_NOTE_FILE_VDM_DISPLAY_DESCRIPTION" class="uk-clearfix uk-width-1-1 uk-margin note_file_vdm_display" />
		<!-- Note_file_vdm_uploader Field. Type: Note. A None Database Field. (joomla) -->
		<field type="note" name="note_file_vdm_uploader" description="COM_SERMONDISTRIBUTOR_CHURCH_NOTE_FILE_VDM_UPLOADER_DESCRIPTION" class="note_file_vdm_uploader" showon="file_type!:" />
		<!-- File_type Field. Type: Entityfiletypes. (custom) -->
		<field
			type="entityfiletypes"
			name="file_type"
			label="COM_SERMONDISTRIBUTOR_CHURCH_FILE_TYPE_LABEL"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="false"
			required="false"
			button="false"
			entity="church"
		/>
		<!-- Addresses Field. Type: Subform. (joomla) -->
		<field
			type="subform"
			name="addresses"
			label="COM_SERMONDISTRIBUTOR_CHURCH_ADDRESSES_LABEL"
			layout="joomla.form.field.subform.repeatable"
			multiple="true"
			buttons="add,remove"
			icon="list"
			max="10"
			min="0">
			<form hidden="true" name="list_addresses_modal" repeat="true">
				<!-- Guid Field. Type: Hidden. (joomla) -->
				<field
					type="hidden"
					name="guid"
					default="0"
					filter="STRING"
				/>
				<!-- Type Field. Type: Addresstype. (custom) -->
				<field
					type="addresstype"
					name="type"
					label="COM_SERMONDISTRIBUTOR_CHURCH_TYPE_LABEL"
					description="COM_SERMONDISTRIBUTOR_CHURCH_TYPE_DESCRIPTION"
					class="list_class"
					layout="joomla.form.field.list-fancy-select"
					multiple="false"
					required="true"
					button="false"
					entity="church"
				/>
				<!-- Line_one Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="line_one"
					label="COM_SERMONDISTRIBUTOR_CHURCH_LINE_ONE_LABEL"
					description="COM_SERMONDISTRIBUTOR_CHURCH_LINE_ONE_DESCRIPTION"
					class="text_area"
					required="true"
					filter="STRING"
					message="COM_SERMONDISTRIBUTOR_CHURCH_LINE_ONE_MESSAGE"
					hint="COM_SERMONDISTRIBUTOR_CHURCH_LINE_ONE_HINT"
				/>
				<!-- Line_two Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="line_two"
					label="COM_SERMONDISTRIBUTOR_CHURCH_LINE_TWO_LABEL"
					description="COM_SERMONDISTRIBUTOR_CHURCH_LINE_TWO_DESCRIPTION"
					class="text_area"
					required="false"
					filter="STRING"
					hint="COM_SERMONDISTRIBUTOR_CHURCH_LINE_TWO_HINT"
				/>
				<!-- Country Field. Type: Countries. (custom) -->
				<field
					type="countries"
					name="country"
					label="COM_SERMONDISTRIBUTOR_CHURCH_COUNTRY_LABEL"
					description="COM_SERMONDISTRIBUTOR_CHURCH_COUNTRY_DESCRIPTION"
					message="COM_SERMONDISTRIBUTOR_CHURCH_COUNTRY_MESSAGE"
					class="list_class"
					layout="joomla.form.field.list-fancy-select"
					multiple="false"
					required="true"
					button="false"
					entity="church"
				/>
				<!-- State Field. Type: List. (joomla) -->
				<field
					type="list"
					name="state"
					label="COM_SERMONDISTRIBUTOR_CHURCH_STATE_LABEL"
					description="COM_SERMONDISTRIBUTOR_CHURCH_STATE_DESCRIPTION"
					class="list_class"
					layout="joomla.form.field.list-fancy-select"
					multiple="false"
					required="true">
					<!-- Option Set. -->
					<option value="">
						COM_SERMONDISTRIBUTOR_CHURCH_SELECT_A_COUNTRY</option>
				</field>
				<!-- City Field. Type: List. (joomla) -->
				<field
					type="list"
					name="city"
					label="COM_SERMONDISTRIBUTOR_CHURCH_CITY_LABEL"
					description="COM_SERMONDISTRIBUTOR_CHURCH_CITY_DESCRIPTION"
					class="list_class"
					layout="joomla.form.field.list-fancy-select"
					multiple="false">
					<!-- Option Set. -->
					<option value="">
						COM_SERMONDISTRIBUTOR_CHURCH_SELECT_A_STATE</option>
				</field>
				<!-- Postal Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="postal"
					label="COM_SERMONDISTRIBUTOR_CHURCH_POSTAL_LABEL"
					description="COM_SERMONDISTRIBUTOR_CHURCH_POSTAL_DESCRIPTION"
					class="text_area"
					required="false"
					hint="COM_SERMONDISTRIBUTOR_CHURCH_POSTAL_HINT"
				/>
			</form>
		</field>
		<!-- Alias Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="alias"
			label="COM_SERMONDISTRIBUTOR_CHURCH_ALIAS_LABEL"
			description="JFIELD_ALIAS_DESC"
			filter="STRING"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_ALIAS_HINT"
		/>
		<!-- Description Field. Type: Textarea. (joomla) -->
		<field
			type="textarea"
			name="description"
			label="COM_SERMONDISTRIBUTOR_CHURCH_DESCRIPTION_LABEL"
			rows="11"
			cols="10"
			description="COM_SERMONDISTRIBUTOR_CHURCH_DESCRIPTION_DESCRIPTION"
			class="text_area span12"
			filter="HTML"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_DESCRIPTION_HINT"
		/>
		<!-- Elders Field. Type: Elder. (custom) -->
		<field
			type="elder"
			name="elders"
			label="COM_SERMONDISTRIBUTOR_CHURCH_ELDERS_LABEL"
			description="COM_SERMONDISTRIBUTOR_CHURCH_ELDERS_DESCRIPTION"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="true"
			required="false"
			button="false"
		/>
		<!-- Website Field. Type: Url. (joomla) -->
		<field
			type="url"
			name="website"
			label="COM_SERMONDISTRIBUTOR_CHURCH_WEBSITE_LABEL"
			size="60"
			maxlength="150"
			description="COM_SERMONDISTRIBUTOR_CHURCH_WEBSITE_DESCRIPTION"
			class="text_area"
			required="true"
			filter="url"
			validated="url"
			scheme="http,https"
			message="COM_SERMONDISTRIBUTOR_CHURCH_WEBSITE_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_WEBSITE_HINT"
		/>
		<!-- Phone Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="phone"
			label="COM_SERMONDISTRIBUTOR_CHURCH_PHONE_LABEL"
			size="10"
			maxlength="50"
			default=""
			description="COM_SERMONDISTRIBUTOR_CHURCH_PHONE_DESCRIPTION"
			class="text_area"
			readonly="false"
			disabled="false"
			required="true"
			validated="tel"
			message="COM_SERMONDISTRIBUTOR_CHURCH_PHONE_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_PHONE_HINT"
		/>
		<!-- Email Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="email"
			label="COM_SERMONDISTRIBUTOR_CHURCH_EMAIL_LABEL"
			size="10"
			maxlength="50"
			description="COM_SERMONDISTRIBUTOR_CHURCH_EMAIL_DESCRIPTION"
			class="text_area"
			required="true"
			filter="STRING"
			message="COM_SERMONDISTRIBUTOR_CHURCH_EMAIL_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_EMAIL_HINT"
		/>
		<!-- Contactname Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="contactname"
			label="COM_SERMONDISTRIBUTOR_CHURCH_CONTACTNAME_LABEL"
			size="10"
			maxlength="50"
			default=""
			description="COM_SERMONDISTRIBUTOR_CHURCH_CONTACTNAME_DESCRIPTION"
			class="text_area"
			readonly="false"
			disabled="false"
			required="true"
			filter="STRING"
			message="COM_SERMONDISTRIBUTOR_CHURCH_CONTACTNAME_MESSAGE"
			hint="COM_SERMONDISTRIBUTOR_CHURCH_CONTACTNAME_HINT"
			autocomplete="on"
		/>
	</fieldset>

	<!-- Metadata Fields. -->
	<fields name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
		<fieldset name="vdmmetadata"
			label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
			<!-- Robots Field. Type: List (joomla) -->
			<field name="robots"
				type="list"
				label="JFIELD_METADATA_ROBOTS_LABEL"
				description="JFIELD_METADATA_ROBOTS_DESC" >
				<option value="">JGLOBAL_USE_GLOBAL</option>
				<option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
				<option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
				<option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
				<option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
			</field>
			<!-- Author Field. Type: Text (joomla) -->
			<field name="author"
				type="text"
				label="JAUTHOR" description="JFIELD_METADATA_AUTHOR_DESC"
				size="20"
			/>
			<!-- Rights Field. Type: Textarea (joomla) -->
			<field name="rights" type="textarea" label="JFIELD_META_RIGHTS_LABEL"
				description="JFIELD_META_RIGHTS_DESC" required="false" filter="string"
				cols="30" rows="2"
			/>
		</fieldset>
	</fields>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this church"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_sermondistributor"
			section="church"
		/>
	</fieldset>
</form>